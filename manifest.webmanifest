{
  "name": "Fichas · Moodboard",
  "short_name": "Fichas",
  "description": "Anota cards para el Moodboard de investigación desde el celular.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F5F8",
  "theme_color": "#F4F5F8",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "compartir_titulo", "text": "compartir_texto", "url": "compartir_url" }
  },
  "shortcuts": [
    { "name": "Nueva Idea", "url": "./#/anotar/nueva?tipo=idea", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Explorar", "url": "./#/explorar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
